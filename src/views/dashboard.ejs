<%- include('partials/header') %>

<main>

    <h1><%= title %></h1>

    <h2>User Information</h2>

    <p>
        <strong>Name:</strong>
        <%= user.name %>
    </p>

    <p>
        <strong>Email:</strong>
        <%= user.email %>
    </p>

    <p>
        <strong>Role:</strong>
        <%= user.role_name %>
    </p>

    <hr>

    <h2>My Volunteer Projects</h2>

    <% if (volunteerProjects.length === 0) { %>

        <p>You have not volunteered for any projects yet.</p>

    <% } else { %>

        <ul>

            <% volunteerProjects.forEach(project => { %>

                <li>

                    <a href="/project/<%= project.project_id %>">
                        <%= project.title %>
                    </a>

                    (<%= new Date(project.project_date).toLocaleDateString() %>)

                    <a href="/remove-volunteer/<%= project.project_id %>">
                        Remove
                    </a>

                </li>

            <% }) %>

        </ul>

    <% } %>

    <hr>

    <p>
        <a href="/">Home</a> |
        <a href="/organizations">Organizations</a> |
        <a href="/projects">Projects</a> |
        <a href="/categories">Categories</a>
    </p>

</main>

<%- include('partials/footer') %>