<%- include('partials/header') %>

    <main>

        <h1>
            <%= title %>
        </h1>

        <p>
            <strong>Description:</strong>
            <%= project.description %>
        </p>

        <p>
            <strong>Date:</strong>
            <%= new Date(project.project_date).toLocaleDateString() %>
        </p>

        <p>
            <strong>Location:</strong>
            <%= project.location %>
        </p>

        <p>
            <strong>Organization:</strong>

            <a href="/organization/<%= project.organization_id %>">
                <%= project.organization_name %>
            </a>

        </p>

        <p>
            <strong>Categories:</strong>

            <% categories.forEach((category, index)=> { %>

                <a href="/category/<%= category.category_id %>">
                    <%= category.name %>
                </a>
                <%= index < categories.length - 1 ? ', ' : '' %>

                    <% }) %>
        </p>
        <p>
            <% if (user && user.role_name==='admin' ) { %>
                <a href="/edit-project/<%= project.project_id %>">
                    Edit Project
                </a>
                <% } %>
        </p>

         <% if (isLoggedIn) { %>

            <% if (!volunteering) { %>

                <p>
                    <a href="/volunteer/<%= project.project_id %>">
                        Volunteer for this project
                    </a>
                </p>

                <% } else { %>

                    <p><strong>You are volunteering for this project.</strong></p>

                    <p>
                        <a href="/remove-volunteer/<%= project.project_id %>">
                            Remove myself as a volunteer
                        </a>
                    </p>

                    <% } %>

                        <% } %>

        <p>
            <a href="/projects">← Back to Projects</a>
        </p>

       
    </main>

    <%- include('partials/footer') %>